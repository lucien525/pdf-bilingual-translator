# 复制此文件为 .env，填入你自己的密钥
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# ---------- 以下为可选项 ----------

# API 地址（默认官方，用中转/代理时改这里）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次 API 调用超时秒数（默认 180）
# DEEPSEEK_TIMEOUT=180

# 中文字体路径（不填则用程序默认扫描目录）
# 程序会自动扫描：
#   D:\file\translate\word_type\
#   项目目录\fonts\
# 如果字体放在别处，取消下面这行的注释并改成你的路径：
# TRANSLATE_FONT_PATH=D:\你的字体目录\SourceHanSerifSC-Regular.otf